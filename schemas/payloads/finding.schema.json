{
  "$defs": {
    "Claim": {
      "description": "A machine-checkable assertion, used by the correlator to detect contradictions.",
      "properties": {
        "subject": {
          "description": "Usually a device_id",
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "description": "e.g. 'interface_errors_above_threshold'",
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        },
        "source_agent": {
          "default": "",
          "title": "Source Agent",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "above",
        "below"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EvidenceItem": {
      "properties": {
        "metric": {
          "description": "Canonical metric name, or a derived signal such as 'topology'",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threshold the value was compared against (same unit)",
          "title": "Threshold"
        },
        "severity": {
          "default": 0.0,
          "description": "0 = at/below warn, 1 = at/beyond crit (piecewise linear)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "above"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": "ok"
        },
        "source_agent": {
          "default": "",
          "title": "Source Agent",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "z_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Robust deviation from the device's own baseline (series only)",
          "title": "Z Score"
        },
        "basis": {
          "default": "threshold",
          "description": "'baseline' = below the fixed threshold but abnormal versus the device's history",
          "enum": [
            "threshold",
            "baseline"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "interpretation"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "Hypothesis": {
      "enum": [
        "normal",
        "link_congestion",
        "weak_wifi",
        "interface_fault",
        "hardware_failure",
        "device_overload",
        "dns_failure",
        "dhcp_failure",
        "upstream_issue"
      ],
      "title": "Hypothesis",
      "type": "string"
    },
    "HypothesisScore": {
      "description": "One agent's contribution to one hypothesis on one device.\n\n`raw` is this agent's share of raw(h, d) (README#confidence); the correlator sums the\nraw contributions of all agents and normalizes by Z(h). `score` is the agent's own\nnormalized view (raw divided by the part of Z(h) the agent can observe).",
      "properties": {
        "hypothesis": {
          "$ref": "#/$defs/Hypothesis"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device the score refers to; null = incident-wide",
          "title": "Device Id"
        },
        "raw": {
          "default": 0.0,
          "description": "Unnormalized weighted evidence sum from this agent",
          "title": "Raw",
          "type": "number"
        },
        "score": {
          "default": 0.0,
          "description": "Agent-local normalized score",
          "title": "Score",
          "type": "number"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "hypothesis"
      ],
      "title": "HypothesisScore",
      "type": "object"
    },
    "Localization": {
      "properties": {
        "root_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Device"
        },
        "symptomatic_devices": {
          "items": {
            "type": "string"
          },
          "title": "Symptomatic Devices",
          "type": "array"
        },
        "affected_devices": {
          "items": {
            "type": "string"
          },
          "title": "Affected Devices",
          "type": "array"
        },
        "affected_segments": {
          "items": {
            "type": "string"
          },
          "title": "Affected Segments",
          "type": "array"
        },
        "partitioned_devices": {
          "items": {
            "type": "string"
          },
          "title": "Partitioned Devices",
          "type": "array"
        },
        "method": {
          "default": "",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "Localization",
      "type": "object"
    },
    "Quality": {
      "enum": [
        "ok",
        "converted",
        "imputed",
        "missing",
        "stale",
        "out_of_range",
        "rejected"
      ],
      "title": "Quality",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "ms",
        "%",
        "count",
        "dBm",
        "dB",
        "Mbps",
        "s"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "agent_version": {
      "default": "1.0.0",
      "title": "Agent Version",
      "type": "string"
    },
    "hypothesis_scores": {
      "items": {
        "$ref": "#/$defs/HypothesisScore"
      },
      "title": "Hypothesis Scores",
      "type": "array"
    },
    "top_hypothesis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hypothesis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "devices_flagged": {
      "items": {
        "type": "string"
      },
      "title": "Devices Flagged",
      "type": "array"
    },
    "metrics_analyzed": {
      "items": {
        "type": "string"
      },
      "title": "Metrics Analyzed",
      "type": "array"
    },
    "metrics_missing": {
      "items": {
        "type": "string"
      },
      "title": "Metrics Missing",
      "type": "array"
    },
    "data_coverage": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Data Coverage",
      "type": "number"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "localization": {
      "anyOf": [
        {
          "$ref": "#/$defs/Localization"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "agent"
  ],
  "title": "FINDING payload (finding/1.0)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
