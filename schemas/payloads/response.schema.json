{
  "$defs": {
    "Direction": {
      "enum": [
        "above",
        "below"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EvidenceItem": {
      "properties": {
        "metric": {
          "description": "Canonical metric name, or a derived signal such as 'topology'",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threshold the value was compared against (same unit)",
          "title": "Threshold"
        },
        "severity": {
          "default": 0.0,
          "description": "0 = at/below warn, 1 = at/beyond crit (piecewise linear)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "above"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": "ok"
        },
        "source_agent": {
          "default": "",
          "title": "Source Agent",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "z_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Robust deviation from the device's own baseline (series only)",
          "title": "Z Score"
        },
        "basis": {
          "default": "threshold",
          "description": "'baseline' = below the fixed threshold but abnormal versus the device's history",
          "enum": [
            "threshold",
            "baseline"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "interpretation"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "Hypothesis": {
      "enum": [
        "normal",
        "link_congestion",
        "weak_wifi",
        "interface_fault",
        "hardware_failure",
        "device_overload",
        "dns_failure",
        "dhcp_failure",
        "upstream_issue"
      ],
      "title": "Hypothesis",
      "type": "string"
    },
    "Quality": {
      "enum": [
        "ok",
        "converted",
        "imputed",
        "missing",
        "stale",
        "out_of_range",
        "rejected"
      ],
      "title": "Quality",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "ms",
        "%",
        "count",
        "dBm",
        "dB",
        "Mbps",
        "s"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "properties": {
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "answer": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "null = cannot tell from available data",
      "title": "Answer"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "explanation": {
      "default": "",
      "title": "Explanation",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "supports": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Supports",
      "type": "array"
    },
    "refutes": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Refutes",
      "type": "array"
    }
  },
  "required": [
    "query_id"
  ],
  "title": "RESPONSE payload (response/1.0)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
